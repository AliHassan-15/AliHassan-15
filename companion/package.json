{
  "name": "eos-companion",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/validate-content.ts && tsx scripts/generate-readme.ts check",
    "build": "next build",
    "start": "npx --yes serve@14.2.4 out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content:validate": "tsx scripts/validate-content.ts",
    "readme:generate": "tsx scripts/generate-readme.ts write",
    "readme:check": "tsx scripts/generate-readme.ts check",
    "verify": "tsx scripts/verify-release.ts",
    "verify:release": "tsx scripts/verify-release.ts --require-build",
    "audit:deps": "pnpm audit --prod --audit-level=high"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.1.2",
    "@react-three/postprocessing": "^3.0.4",
    "framer-motion": "^12.4.10",
    "gsap": "^3.12.7",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.17.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.185.0",
    "eslint": "^9.33.0",
    "eslint-config-next": "^15.5.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.23.4",
    "typescript": "^5.9.2"
  }
}
